# ─── Site engine, licensed build ─────────────────────────────────────────────
#
# Copy to .env.local and fill in. Nothing here has a safe default in production
# except where it says so.
#
#   cp .env.example .env.local
#   npm run db:push
#   npm run dev

# ─── Database (required) ─────────────────────────────────────────────────────
#
# One Postgres database per business. Neon, Supabase and a plain Postgres box
# all work. Use the POOLED connection string on a serverless host: a direct
# connection runs out of backends under any real traffic.
DATABASE_URL=postgres://user:password@host:5432/dbname

# How many connections one serverless instance may hold. Leave it alone unless
# your pooler is complaining.
# SITE_DB_POOL_MAX=5

# ─── Sessions (required in production) ───────────────────────────────────────
#
# Signs the staff, edit-mode and customer cookies. At least 32 random
# characters. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs everybody out, which is the emergency lever if a session
# is ever suspected of being stolen.
SITE_JWT_SECRET=

# ─── The override code ───────────────────────────────────────────────────────
#
# One code that opens the order desk regardless of any password, and the only
# thing that opens the diagnostics screen. It exists for the call that starts
# "nobody can sign in".
#
# There is a default compiled into the source. SET YOUR OWN HERE on any
# deployment you hand to somebody else — the diagnostics screen will keep
# telling you, loudly, until you do. Every use of it is written to the audit
# log with the address it came from.
SITE_MASTER_CODE=

# ─── The order desk subdomain ────────────────────────────────────────────────
#
# The private half of the site lives on its own hostname: orders.example.com.
# Change the label here if you would rather it were admin. or desk.
# The desk is also always reachable at /console on the main host, which is how
# it works on a preview URL and before DNS is set up.
# SITE_ORDERS_SUBDOMAIN=orders

# ─── Licence server (licensed build only) ────────────────────────────────────
#
# Where this site checks that its key is still good, and where it uploads its
# takings. The standalone build produced by `npm run vend:standalone` has no
# such setting, because it has no such code.
SITE_LICENSE_API=https://your-admin-console.example.com

# A secret shared with the cron that triggers the heartbeat, so a stranger
# cannot make your site check in on demand. Any long random string.
SITE_CRON_SECRET=

# ─── Build edition ───────────────────────────────────────────────────────────
#
# 'licensed' or 'standalone'. Read at BUILD time, not at runtime: a licensed
# deployment must not be able to talk its way out of the licence check by
# setting an environment variable.
SITE_EDITION=licensed
